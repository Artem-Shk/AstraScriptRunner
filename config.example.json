{
  "directory": "./scripts",
  "filter": ".sh",
  "mode": "parallel",
  "recursive": true,
  "force": false,
  "chmod": false,
  "sort": "name",
  "reverse": false,
  "jobs": 4,
  "timeout": 120,
  "output_dir": "./logs",
  "dry_run": false,
  "verbose": false,
  "log": true,
  "continue_on_error": true,
  "script_args": []
}
